<nav class="cf-nav" id="cf-nav">
  <div class="cf-nav__brand">{{ section.settings.brand_name }}</div>
  <a href="{{ section.settings.cta_link }}" class="cf-nav__cta">{{ section.settings.cta_text }}</a>
</nav>

{% schema %}
{
  "name": "Crochet Nav",
  "settings": [
    { "type": "text", "id": "brand_name", "label": "Brand Name", "default": "Crochet Fit Guide" },
    { "type": "text", "id": "cta_text", "label": "CTA Button Text", "default": "Get the Perfect Fit" },
    { "type": "url", "id": "cta_link", "label": "CTA Button Link" }
  ]
}
{% endschema %}
