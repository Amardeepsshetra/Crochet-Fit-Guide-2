<section class="cf-hero" id="hero">
  <div class="cf-hero__texture"></div>
  <div class="cf-hero__left">
    <div class="cf-hero__eyebrow">{{ section.settings.eyebrow }}</div>
    <h1 class="cf-hero__title">{{ section.settings.title }}</h1>
    <p class="cf-hero__sub">{{ section.settings.subtitle }}</p>
    <a href="{{ section.settings.btn_link }}" class="cf-btn cf-btn--dark">{{ section.settings.btn_text }}</a>
  </div>
  <div class="cf-hero__right">
    <div class="cf-hero__visual">
      <div class="cf-hero__visual-inner">
        <span class="cf-hero__visual-icon">🧶</span>
        <p class="cf-hero__visual-text">{{ section.settings.visual_quote }}</p>
      </div>
    </div>
  </div>
  <div class="cf-trust-bar">
    {% for block in section.blocks %}
      <div class="cf-trust-item" {{ block.shopify_attributes }}>
        <div class="cf-trust-dot"></div>
        {{ block.settings.text }}
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Crochet Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow Label", "default": "The Perfect Fit Formula" },
    { "type": "textarea", "id": "title", "label": "Headline", "default": "Your Next Crochet Sweater Will Actually Fit You" },
    { "type": "textarea", "id": "subtitle", "label": "Subheadline", "default": "You followed the pattern perfectly. Now follow a simple system that adjusts it to your body — so the finished piece looks as good on you as it did in the picture." },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Get the Perfect Fit →" },
    { "type": "url", "id": "btn_link", "label": "Button Link" },
    { "type": "textarea", "id": "visual_quote", "label": "Visual Card Quote", "default": "\"I made it.\" — You, after your next sweater fits." }
  ],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust Item",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "1,200+ Makers" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Crochet Hero",
      "blocks": [
        { "type": "trust_item", "settings": { "text": "1,200+ Makers" } },
        { "type": "trust_item", "settings": { "text": "4.9 Star Rating" } },
        { "type": "trust_item", "settings": { "text": "100% Refund Guarantee" } },
        { "type": "trust_item", "settings": { "text": "One Evening to Apply" } }
      ]
    }
  ]
}
{% endschema %}
