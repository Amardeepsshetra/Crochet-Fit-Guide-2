<section class="cf-who" id="who">
  <div class="cf-section__label reveal">{{ section.settings.label }}</div>
  <h2 class="cf-section__title reveal stagger-1">{{ section.settings.title }}</h2>
  <div class="cf-who__grid">
    {% for block in section.blocks %}
      <div class="cf-who__card reveal stagger-{{ forloop.index }}" {{ block.shopify_attributes }}>
        <div class="cf-who__icon">{{ block.settings.icon }}</div>
        <div class="cf-who__title">{{ block.settings.title }}</div>
        <div class="cf-who__desc">{{ block.settings.description }}</div>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Crochet Who",
  "settings": [
    { "type": "text", "id": "label", "label": "Section Label", "default": "Who This Is For" },
    { "type": "textarea", "id": "title", "label": "Title", "default": "Three Makers. One System." }
  ],
  "blocks": [
    {
      "type": "persona",
      "name": "Persona Card",
      "settings": [
        { "type": "text", "id": "icon", "label": "Emoji Icon", "default": "🧶" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "description", "label": "Description" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Crochet Who",
      "blocks": [
        { "type": "persona", "settings": { "icon": "🧶", "title": "The Eager Beginner Moving Into Wearables", "description": "You have made blankets and scarves with confidence. Now you want to make a sweater — but the jump to garments feels overwhelming and the risk of wasting good yarn feels too high." } },
        { "type": "persona", "settings": { "icon": "👚", "title": "The Frustrated Maker With Ill-Fitting Projects", "description": "You have finished garments that looked perfect on the hook but wrong on your body. You are tired of guessing and ready for a system that actually works." } },
        { "type": "persona", "settings": { "icon": "📏", "title": "The Careful Crocheter Who Fears Touching the Pattern", "description": "You love the craft but worry that adjusting stitch counts will ruin the design. You need a safe, structured method to make changes without breaking what makes the pattern beautiful." } }
      ]
    }
  ]
}
{% endschema %}
