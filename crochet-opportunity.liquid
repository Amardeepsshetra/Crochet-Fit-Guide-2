<section class="cf-opportunity" id="opportunity">
  <div class="cf-section__label reveal">{{ section.settings.label }}</div>
  <h2 class="cf-section__title reveal stagger-1">{{ section.settings.title }}</h2>
  <div class="cf-opp__grid">
    <div class="reveal stagger-2">
      {{ section.settings.body_content }}
    </div>
    <div class="cf-opp__visual reveal stagger-3">
      <div class="cf-opp__icon">📐</div>
      <p class="cf-opp__visual-quote">{{ section.settings.visual_quote }}</p>
      <div class="cf-opp__steps">
        {% for block in section.blocks %}
          <div class="cf-opp__step" {{ block.shopify_attributes }}>
            <div class="cf-opp__num">{{ forloop.index }}</div>
            {{ block.settings.step_text }}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Crochet Opportunity",
  "settings": [
    { "type": "text", "id": "label", "label": "Section Label", "default": "The Opportunity" },
    { "type": "textarea", "id": "title", "label": "Title", "default": "What Changes When You Stop Resizing and Start Regrading" },
    { "type": "richtext", "id": "body_content", "label": "Body Content" },
    { "type": "textarea", "id": "visual_quote", "label": "Visual Quote", "default": "Picture this. You find a pattern you love. You sit down for one evening, run it through the system, and know — before you cast on — exactly how it will fit." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "step_text", "label": "Step Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Crochet Opportunity",
      "blocks": [
        { "type": "step", "settings": { "step_text": "Measure & diagnose the pattern" } },
        { "type": "step", "settings": { "step_text": "Isolate the sections that need adjusting" } },
        { "type": "step", "settings": { "step_text": "Apply targeted changes that respect the stitch repeat" } },
        { "type": "step", "settings": { "step_text": "Crochet with certainty. Try it on. It fits." } }
      ]
    }
  ]
}
{% endschema %}
